# Copialo a .env.dev o .env.prod EN LA VM y completalo. No se commitea: tiene contraseñas.
# El CD no lo usa (le pasa estas mismas variables desde los secrets del environment de GitHub);
# hace falta solo para desplegar a mano desde la VM.
#
#   set -a && . ./.env.dev && set +a && docker stack deploy -c docker-stack.yml snippet-searcher
#
# El set -a es necesario porque docker stack deploy, al reves de docker compose, no lee el archivo.

# que tag de las imagenes usar: dev o prod
TAG=dev

# el dominio del ambiente. nginx lo usa en el server_name y en la ruta del certificado
DOMAIN=grupo3-snippet-dev.duckdns.org

# ruta absoluta de este repo clonado en la VM, de donde salen la config de nginx y el webroot
INFRA_DIR=/home/azureuser/snippet-searcher-infra

# credenciales de las dos bases. Las crea Postgres la primera vez que arranca: si las cambias
# despues, los servicios dejan de conectar contra los datos que ya existen
SNIPPET_DB_USER=
SNIPPET_DB_PASSWORD=
PERMISSION_DB_USER=
PERMISSION_DB_PASSWORD=
